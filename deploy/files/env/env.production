# Template of /opt/uzero-wpup/.env (0600, owner wpup). Created ONCE by
# deploy/steps/54-web.sh; it never overwrites an existing .env.
# It contains NO secrets: the database uses peer authentication over the Unix
# socket and the KEK arrives as a systemd credential. APP_KEY is generated on
# the server by deploy/release.sh (artisan key:generate).
APP_NAME="Uzero wpup"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=@APP_URL@
APP_TIMEZONE=Europe/Madrid

APP_LOCALE=ca
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=single
LOG_LEVEL=info

# PostgreSQL over the Unix socket, peer authentication (ADR-0004). No password.
DB_CONNECTION=pgsql
DB_HOST=/var/run/postgresql
DB_PORT=5432
DB_DATABASE=wpup
DB_USERNAME=wpup_app
DB_OWNER_USERNAME=wpup_owner
DB_PASSWORD=

# Redis over its Unix socket, no password (file permissions protect it).
REDIS_CLIENT=phpredis
REDIS_HOST=/run/redis/redis-server.sock
REDIS_PORT=0
REDIS_PASSWORD=null

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=redis
CACHE_STORE=redis
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Secrets (ADR-0002): KEK from the systemd credential, operator from SUDO_USER.
WPUP_KEK_PROVIDER=systemd
WPUP_KEK_VERSION=1
WPUP_IDENTITY_MODE=sudo
WPUP_SERVICE_USER=wpup

# Fixed public egress IP of the tool (ADR-0003). Fill it in; network.sh checks it.
WPUP_EGRESS_IP=
