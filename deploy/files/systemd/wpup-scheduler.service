[Unit]
Description=Uzero wpup: scheduler (schedule:work, every minute)
Documentation=file:///opt/uzero-wpup/docs/runbooks/desplegament.md
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target postgresql.service redis-server.service
ConditionPathExists=/opt/uzero-wpup/artisan

[Service]
# `schedule:work` runs `schedule:run` every minute from a single process
# (ADR-0006). A service is simpler than a timer: no overlapping starts and
# systemd restarts it if it dies.
Type=simple
User=wpup
Group=wpup
WorkingDirectory=/opt/uzero-wpup
Environment=HOME=/var/lib/wpup
ExecStart=/usr/bin/php artisan schedule:work
Restart=always
RestartSec=5
TimeoutStopSec=60

# See wpup-horizon.service for the meaning of every line below.
# The LoadCredentialEncrypted=wpup-kek-v<N> lines come from the generated
# drop-in 10-kek.conf (deploy/bin/wpup-kek-units).

StateDirectory=wpup
StateDirectoryMode=0700
PrivateTmp=yes
UMask=0077

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/uzero-wpup/storage /opt/uzero-wpup/bootstrap/cache /var/lib/wpup
ProtectHome=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
