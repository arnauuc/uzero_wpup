# Optional, non-secret deployment settings. Copy to deploy/config.env (ignored by git).
# Never put keys, tokens or passwords here.
WPUP_APP_DIR=/opt/uzero-wpup
WPUP_SERVICE_USER=wpup
WPUP_OPERATORS_GROUP=wpup-operators
WPUP_ADMINS_GROUP=wpup-admins
# Local port where nginx serves the panel (127.0.0.1 only); Tailscale Serve proxies it.
WPUP_WEB_PORT=8080
