#!/usr/bin/env bash
# Generates the systemd drop-in that hands the KEK to Horizon and the scheduler:
# one LoadCredentialEncrypted= line for every sealed KEK version found in
# /etc/credstore.encrypted (ADR-0002, rotacio-kek.md). Run as root; called by
# deploy/steps/55-systemd.sh, so after a rotation `provision.sh --only 55`
# is all that is needed. Prints "changed" or "unchanged" and reloads systemd
# only when something changed. It never restarts the services.
set -euo pipefail

credstore="${WPUP_CREDSTORE:-/etc/credstore.encrypted}"
units=(wpup-horizon wpup-scheduler)
changed=0

body="# Generated by deploy/bin/wpup-kek-units. Do not edit.
[Service]"
found=0
for f in "$credstore"/wpup-kek-v[0-9]*; do
    [[ -f "$f" ]] || continue
    name="$(basename "$f")"
    body+=$'\n'"LoadCredentialEncrypted=$name:$f"
    found=1
done
if [[ $found -eq 0 ]]; then
    echo "wpup-kek-units: no sealed KEK in $credstore (step 52)." >&2
    exit 1
fi

for u in "${units[@]}"; do
    dir="/etc/systemd/system/$u.service.d"
    file="$dir/10-kek.conf"
    install -d -m 0755 "$dir"
    if [[ "$(cat "$file" 2>/dev/null || true)" != "$body" ]]; then
        printf '%s\n' "$body" >"$file"
        chmod 0644 "$file"
        changed=1
    fi
done

if [[ $changed -eq 1 ]]; then
    systemctl daemon-reload
    echo "changed"
else
    echo "unchanged"
fi
