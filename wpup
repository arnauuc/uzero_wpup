#!/usr/bin/env bash
# Entry point of the Uzero wpup CLI (ADR-0002). Operators run it as
# `sudo -u wpup wpup <command>`, so it must only expose the tool's own commands:
# internal artisan commands (tinker, migrate, key:generate, user:bootstrap...)
# would let an operator act as the service user and read the KEK.
# Keep this list in sync with config('wpup.cli.allowed_commands'); the
# application checks it again when the command starts.
set -euo pipefail

root="$(dirname "$(readlink -f "$0")")"
allowed='^(list|help|site:.*|user:add|user:list|user:role|user:deactivate|lock:.*|backup:.*|agent:.*|client:.*|billing:.*|ssh-key:.*|secrets:.*|staging:.*|run:.*|inventory|plan|update|verify|rollback|runs|report|cleanup|doctor|stats)$'

for arg in "$@"; do
    case "$arg" in
        --env|--env=*)
            echo "wpup: l'opció --env no està permesa." >&2
            exit 64
            ;;
    esac
done

command="${1:-list}"
case "$command" in
    -h|--help|-V|--version) ;;
    -*)
        echo "wpup: indica primer la comanda (p. ex. wpup user:list)." >&2
        exit 64
        ;;
    *)
        if ! [[ "$command" =~ $allowed ]]; then
            echo "wpup: comanda no permesa: $command" >&2
            exit 64
        fi
        ;;
esac

export WPUP_CLI=1
exec php "$root/artisan" "$@"
